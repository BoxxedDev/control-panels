{
  "multipart": [
    {
      "apply": {
        "model": "panels:block/cable/core"
      },
      "when": {
        "east": "true|false",
        "north": "true|false",
        "south": "true|false",
        "west": "true|false"
      }
    },
    {
      "apply": {
        "model": "panels:block/cable/facing"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "panels:block/cable/facing",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "panels:block/cable/facing",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "panels:block/cable/facing",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    }
  ]
}